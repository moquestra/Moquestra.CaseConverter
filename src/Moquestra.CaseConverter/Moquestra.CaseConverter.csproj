<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Moquestra.CaseConverter</PackageId>
    <Description>A string extension library for casing conversion.</Description>
    <PackageTags>string;casing;case-converter;pascalcase;camelcase;snake-case;kebab-case;screaming-snake-case;cobol-case;header-case;title-case;train-case;sentence-case;flatcase</PackageTags>
  </PropertyGroup>

</Project>
